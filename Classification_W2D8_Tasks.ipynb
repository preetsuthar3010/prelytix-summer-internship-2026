    "---\n",
    "## Task 2: Sigmoid Calculation\n",
    "Use the sigmoid formula: sigma(z) = 1 / (1 + e^(-z))\n",
    "\n",
    "**a)** Calculate sigma(0). What does this mean?  \n",
    "**b)** Calculate sigma(2). Is the model leaning towards Class 0 or Class 1?  \n",
    "**c)** Calculate sigma(-3). What would be the predicted class (threshold=0.5)?  \n",
    "**d)** If sigma(z) = 0.75 and threshold = 0.5, what is the predicted label?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "task2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Task 2: Sigmoid Calculation\n",
    "import numpy as np\n",
    "\n",
    "def sigmoid(z):\n",
    "    return 1 / (1 + np.exp(-z))\n",
    "\n",
    "# a) sigma(0)\n",
    "val_a = sigmoid(0)\n",
    "print(\"a) sigma(0):\")\n",
    "print(f\"   sigma(0) = {val_a:.4f}\")\n",
    "print(\"   Meaning: Maximum uncertainty (50/50 chance). The model has no lean towards either class.\")\n",
    "\n",
    "# b) sigma(2)\n",
    "val_b = sigmoid(2)\n",
    "print(f\"\\nb) sigma(2):\")\n",
    "print(f\"   sigma(2) = {val_b:.4f}\")\n",
    "print(f\"   -> {val_b*100:.1f}% probability of Class 1. Model is leaning towards CLASS 1.\")\n",
    "\n",
    "# c) sigma(-3)\n",
    "val_c = sigmoid(-3)\n",
    "threshold = 0.5\n",
    "pred_c = 1 if val_c >= threshold else 0\n",
    "print(f\"\\nc) sigma(-3):\")\n",
    "print(f\"   sigma(-3) = {val_c:.4f}\")\n",
    "print(f\"   {val_c:.4f} < {threshold} -> Predicted Class: {pred_c} (Class 0)\")\n",
    "\n",
    "# d) Threshold decision\n",
    "prob_d = 0.75\n",
    "pred_d = 1 if prob_d >= threshold else 0\n",
    "print(f\"\\nd) sigma(z) = {prob_d}, threshold = {threshold}:\")\n",
    "print(f\"   {prob_d} >= {threshold} -> Predicted Label: Class {pred_d}\")\n",
    "\n",
    "# Visualise the sigmoid curve\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "z_vals = np.linspace(-8, 8, 300)\n",
    "sig_vals = sigmoid(z_vals)\n",
    "\n",
    "plt.figure(figsize=(8, 4))\n",
    "plt.plot(z_vals, sig_vals, color='steelblue', linewidth=2, label='sigma(z)')\n",
    "plt.axhline(y=0.5, color='crimson', linestyle='--', label='Default threshold = 0.5')\n",
    "plt.axvline(x=0, color='gray', linestyle=':', alpha=0.6)\n",
    "for z, label in [(0, 'z=0'), (2, 'z=2'), (-3, 'z=-3')]:\n",
    "    plt.scatter([z], [sigmoid(z)], zorder=5, s=80)\n",
    "    plt.annotate(f'{label}\\n({sigmoid(z):.2f})', xy=(z, sigmoid(z)),\n",
    "                 xytext=(z+0.4, sigmoid(z)-0.07), fontsize=8)\n",
    "plt.xlabel('z (linear input)')\n",
    "plt.ylabel('sigma(z) = P(Y=1|X)')\n",
    "plt.title('Task 2: The Sigmoid Function')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
