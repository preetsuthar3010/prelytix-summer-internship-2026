    "---\n",
    "## Task 4: Log Loss Calculation\n",
    "A model makes 3 predictions:\n",
    "- Sample 1: y=1, y_hat=0.90\n",
    "- Sample 2: y=0, y_hat=0.20\n",
    "- Sample 3: y=1, y_hat=0.05\n",
    "\n",
    "**a)** Calculate the loss for each sample.  \n",
    "**b)** Which sample has the highest loss? Why?  \n",
    "**c)** Calculate the average Log Loss for these 3 samples."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "task4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Task 4: Log Loss Calculation\n",
    "import numpy as np\n",
    "\n",
    "def log_loss_single(y_actual, y_pred):\n",
    "    # Clip to avoid log(0)\n",
    "    y_pred = np.clip(y_pred, 1e-15, 1 - 1e-15)\n",
    "    if y_actual == 1:\n",
    "        return -np.log(y_pred)\n",
    "    else:\n",
    "        return -np.log(1 - y_pred)\n",
    "\n",
    "samples = [\n",
    "    (1, 0.90, \"Sample 1\"),\n",
    "    (0, 0.20, \"Sample 2\"),\n",
    "    (1, 0.05, \"Sample 3\")\n",
    "]\n",
    "\n",
    "print(\"a) Per-Sample Log Loss:\")\n",
    "print(\"-\" * 50)\n",
    "losses = []\n",
    "for y, y_hat, name in samples:\n",
    "    loss = log_loss_single(y, y_hat)\n",
    "    losses.append(loss)\n",
    "    if y == 1:\n",
    "        formula = f\"-log({y_hat}) = {loss:.3f}\"\n",
    "    else:\n",
    "        formula = f\"-log(1-{y_hat}) = -log({1-y_hat}) = {loss:.3f}\"\n",
    "    print(f\"  {name}: y={y}, y_hat={y_hat} -> Loss = {formula}\")\n",
    "\n",
    "print(\"\\nb) Sample with highest loss:\")\n",
    "max_idx = int(np.argmax(losses))\n",
    "print(f\"   -> Sample {max_idx+1} (loss = {losses[max_idx]:.3f})\")\n",
    "print(f\"   Reason: y=1 (actual positive) but y_hat={samples[max_idx][1]} (model predicted\")\n",
    "print(\"   near-zero probability). This is a CONFIDENTLY WRONG prediction.\")\n",
    "print(\"   Log loss penalises such predictions catastrophically (loss -> infinity).\")\n",
    "\n",
    "avg_loss = np.mean(losses)\n",
    "print(f\"\\nc) Average Log Loss:\")\n",
    "print(f\"   = ({' + '.join([f'{l:.3f}' for l in losses])}) / 3\")\n",
    "print(f\"   = {sum(losses):.3f} / 3\")\n",
    "print(f\"   = {avg_loss:.3f}\")"
   ]
  },
